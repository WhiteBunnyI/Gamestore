@page
@model Gamestore.Pages.LibraryModel
@{
}

<div id="card-grid" class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 container m-3">
    <div class="col">
        <div class="card h-100 shadow-sm flex-shrink-1">
            <img src="https://placehold.co/600x400/e9ecef/495057?text=Название" class="card-img-top" alt="Альт. название">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Название карточки</h5>
                <span class="badge bg-secondary w-50 mb-2">0/999 достижений</span>
                <p class="card-text text-muted flex-grow-1">Короткое описание для данной карточки</p>
                <div class="mt-auto">
                    <div class="mb-3">
                        <span>Цена покупки</span> 
                        <br />
                        <span>Дата покупки</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/library.js" asp-append-version="true"></script>
}